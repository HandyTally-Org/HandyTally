# Local secrets for `supabase functions serve --env-file supabase/functions/.env`.
# Copy to .env in this directory. Production values are set with `supabase secrets set`.

# send-invoice
RESEND_API_KEY=
INVOICE_FROM_ADDRESS="HandyTally <invoices@example.com>"
INVOICE_REPLY_TO=

# upsert-calendar-event
# Sends iCalendar invites through Resend using RESEND_API_KEY and
# INVOICE_FROM_ADDRESS above. Optional sender override for invites only:
CALENDAR_FROM_ADDRESS=

# create-organization
BASE_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_HOSTED_ZONE_ID=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
GITHUB_TOKEN=
GITHUB_REPO=HandyTally-Org/HandyTally
