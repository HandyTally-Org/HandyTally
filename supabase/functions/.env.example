# Local secrets for `supabase functions serve --env-file supabase/functions/.env`.
# Copy to .env in this directory. Production values are set with `supabase secrets set`.

# send-invoice
RESEND_API_KEY=
INVOICE_FROM_ADDRESS="HandyTally <invoices@example.com>"
INVOICE_REPLY_TO=

# upsert-calendar-event and calendar-connect
NYLAS_API_KEY=
NYLAS_API_URI=https://api.us.nylas.com
# calendar-connect: the Nylas application's client id (Dashboard -> App settings)
NYLAS_CLIENT_ID=
# upsert-calendar-event: optional shared fallback calendar for jobs whose creator
# has not connected their own (HT-1). Leave blank to skip such jobs.
NYLAS_GRANT_ID=
NYLAS_CALENDAR_ID=

# create-organization
BASE_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_HOSTED_ZONE_ID=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
GITHUB_TOKEN=
GITHUB_REPO=HandyTally-Org/HandyTally
