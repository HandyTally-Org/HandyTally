// Cloudflare Workers configuration for the HandyTally web app (HT-31).
//
// The app is a static Expo export (`npx expo export --platform web` -> dist/).
// This is an assets-only Worker: there is no script, Cloudflare just serves dist/
// from its edge. CI (.github/workflows/ci.yml) builds dist/ and runs
// `wrangler deploy` from this directory on every push to master.
//
// Routes: the apex and www (HT-31), plus every first-level subdomain (HT-37).
// One bundle serves all customers; the app works out the organization from the
// hostname (HT-38). A customer subdomain therefore needs no DNS record, no
// deploy and no config of its own: the proxied wildcard `*` A record in
// Cloudflare DNS plus the wildcard route below cover it. Removing a route is
// the rollback for that hostname.
{
  "name": "handytally-web",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "routes": [
    { "pattern": "handytally.com/*", "zone_name": "handytally.com" },
    { "pattern": "www.handytally.com/*", "zone_name": "handytally.com" },
    { "pattern": "*.handytally.com/*", "zone_name": "handytally.com" }
  ],
  "assets": {
    "directory": "./dist",
    // Expo Router emits one HTML file per route, and dynamic routes such as
    // jobs/[id].tsx become literal `jobs/[id].html`, which no host serves for
    // /jobs/123. Fall back to index.html so the router resolves deep links
    // client-side instead of returning a 404.
    "not_found_handling": "single-page-application"
  }
}
